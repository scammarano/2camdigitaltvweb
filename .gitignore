# Runtime configuration and secrets (never commit)
/config/config.php
/config/*.local.php
/config/secret*
/.env
/.env.*
!/.env.example
**/*.pem
**/*.key
**/id_rsa*

# Uploaded customer data and server state
/storage/*
!/storage/.htaccess
!/storage/README.md
/public/downloads/
/public/tv.apk
/app/release-assets/
/public/uploads/
/backups/
/tmp/
/cache/
/logs/

# Packaging and local cache
*.zip
*.apk
*.sql.gz
.DS_Store
.vscode/
.idea/
/vendor/
/node_modules/

# Ephemeral isolated CI identities and rendered fixtures
/.*-http-fixture.json
/.browser-session.json
/public/_ui-*.html
/test-results/
